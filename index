<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>FutPlay — Cupons de Futebol</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#07111f;color:#fff;font-family:Arial,sans-serif}
header{background:#0d1b2d;padding:18px 15px;position:sticky;top:0;z-index:5}
.logo{font-size:25px;font-weight:800;color:#28e07f}
.sub{font-size:12px;color:#9eafc4;margin-top:4px}
.wrap{max-width:900px;margin:auto;padding:15px}
.balance{background:#10243a;border:1px solid #1d3855;border-radius:15px;padding:16px;margin-bottom:15px}
.balance b{font-size:23px}
.filters{display:flex;gap:8px;overflow:auto;margin-bottom:15px}
.filters button{white-space:nowrap;background:#10243a;color:#fff;border:1px solid #29445f;border-radius:20px;padding:10px 15px}
.filters button.active{background:#20c970;color:#06120b;border-color:#20c970}
.game{background:#0e1d30;border:1px solid #203a56;border-radius:15px;margin-bottom:13px;padding:15px}
.league{font-size:12px;color:#8fa4bb;margin-bottom:10px}
.teams{display:flex;justify-content:space-between;align-items:center;font-weight:bold}
.vs{color:#71859b;font-size:12px}
.markets{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-top:13px}
.market{background:#142a40;color:#fff;border:1px solid #29445f;border-radius:9px;padding:11px;text-align:left}
.market span{display:block;font-size:11px;color:#91a5ba;margin-bottom:3px}
.market strong{color:#31e783}
.market.selected{background:#145a3b;border-color:#2ee981}
.coupon{position:fixed;bottom:0;left:0;right:0;background:#0b1929;border-top:1px solid #29445f;padding:13px;z-index:10}
.coupon-inner{max-width:900px;margin:auto}
.row{display:flex;justify-content:space-between;margin:5px 0}
.odd{font-size:22px;color:#2ff080;font-weight:800}
#create{width:100%;padding:14px;border:0;border-radius:10px;background:#20d477;color:#03130a;font-weight:800;font-size:16px;margin-top:9px}
#create:disabled{background:#334557;color:#8797a8}
.empty{text-align:center;color:#8193a8;padding:25px}
.notice{font-size:11px;color:#8396aa;margin-top:8px;text-align:center}
@media(min-width:700px){.markets{grid-template-columns:repeat(4,1fr)}}
</style>
</head>

<body>

<header>
  <div class="wrap">
    <div class="logo">⚽ FUTPLAY</div>
    <div class="sub">Cupons de futebol • Demonstração</div>
  </div>
</header>

<main class="wrap">

<div class="balance">
  <div style="color:#91a5ba;font-size:13px">ODD DO CUPOM</div>
  <b id="totalOdd">1.00</b>
  <div style="color:#71869c;font-size:12px;margin-top:5px">
    Selecione mercados para montar seu cupom
  </div>
</div>

<div class="filters">
  <button class="active" onclick="filterGames('todos',this)">Todos</button>
  <button onclick="filterGames('hoje',this)">Hoje</button>
  <button onclick="filterGames('amanha',this)">Amanhã</button>
</div>

<div id="games">

<div class="game" data-day="hoje">
<div class="league">🇧🇷 BRASIL • Campeonato</div>
<div class="teams"><span>Flamengo</span><span class="vs">x</span><span>Palmeiras</span></div>
<div class="markets">
<button class="market" onclick="pick(this,1.55,'Flamengo vence')"><span>Resultado</span>Flamengo <strong>1.55</strong></button>
<button class="market" onclick="pick(this,1.80,'Mais de 2.5 gols')"><span>Total de gols</span>+2.5 gols <strong>1.80</strong></button>
<button class="market" onclick="pick(this,1.70,'Ambas marcam')"><span>Gols</span>Ambas marcam <strong>1.70</strong></button>
<button class="market" onclick="pick(this,2.10,'Mais de 3.5 gols')"><span>Total de gols</span>+3.5 gols <strong>2.10</strong></button>
</div>
</div>

<div class="game" data-day="hoje">
<div class="league">🇪🇺 EUROPA • Futebol</div>
<div class="teams"><span>Barcelona</span><span class="vs">x</span><span>Inter</span></div>
<div class="markets">
<button class="market" onclick="pick(this,1.65,'Barcelona vence')"><span>Resultado</span>Barcelona <strong>1.65</strong></button>
<button class="market" onclick="pick(this,1.75,'Mais de 2.5 gols')"><span>Total de gols</span>+2.5 gols <strong>1.75</strong></button>
<button class="market" onclick="pick(this,1.68,'Ambas marcam')"><span>Gols</span>Ambas marcam <strong>1.68</strong></button>
<button class="market" onclick="pick(this,2.25,'Mais de 3.5 gols')"><span>Total de gols</span>+3.5 gols <strong>2.25</strong></button>
</div>
</div>

<div class="game" data-day="amanha">
<div class="league">🇬🇧 INGLATERRA • Premier</div>
<div class="teams"><span>Liverpool</span><span class="vs">x</span><span>Chelsea</span></div>
<div class="markets">
<button class="market" onclick="pick(this,1.60,'Liverpool vence')"><span>Resultado</span>Liverpool <strong>1.60</strong></button>
<button class="market" onclick="pick(this,1.72,'Mais de 2.5 gols')"><span>Total de gols</span>+2.5 gols <strong>1.72</strong></button>
<button class="market" onclick="pick(this,1.66,'Ambas marcam')"><span>Gols</span>Ambas marcam <strong>1.66</strong></button>
<button class="market" onclick="pick(this,2.20,'Mais de 3.5 gols')"><span>Total de gols</span>+3.5 gols <strong>2.20</strong></button>
</div>
</div>

</div>
</main>

<div class="coupon">
<div class="coupon-inner">
<div class="row">
<span>Seleções: <b id="count">0</b></span>
<span>Odd: <b class="odd" id="couponOdd">1.00</b></span>
</div>
<button id="create" disabled onclick="createCoupon()">Montar cupom</button>
<div class="notice">Odd mínima para o cupom: 2.00 • Ambiente demonstrativo</div>
</div>
</div>

<script>
let selections=[];
let odd=1;

function pick(btn,value,name){
  const index=selections.findIndex(x=>x.btn===btn);

  if(index>=0){
    selections.splice(index,1);
    btn.classList.remove('selected');
  }else{
    selections.push({btn,value,name});
    btn.classList.add('selected');
  }

  calculate();
}

function calculate(){
  odd=1;
  selections.forEach(x=>odd*=x.value);
  odd=Math.round(odd*100)/100;

  document.getElementById('totalOdd').textContent=odd.toFixed(2);
  document.getElementById('couponOdd').textContent=odd.toFixed(2);
  document.getElementById('count').textContent=selections.length;

  const button=document.getElementById('create');
  button.disabled=odd<2;
  button.textContent=odd>=2?'Montar cupom':'Odd mínima 2.00';
}

function createCoupon(){
  if(odd<2)return;

  let texto='SEU CUPOM\\n\\n';
  selections.forEach((x,i)=>{
    texto+=(i+1)+'. '+x.name+' — '+x.value+'\\n';
  });
  texto+='\\nODD TOTAL: '+odd.toFixed(2);

  alert(texto);
}

function filterGames(day,button){
  document.querySelectorAll('.filters button').forEach(b=>b.classList.remove('active'));
  button.classList.add('active');

  document.querySelectorAll('.game').forEach(game=>{
    game.style.display=(day==='todos'||game.dataset.day===day)?'block':'none';
  });
}
</script>

</body>
</html>
